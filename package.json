{
  "name": "vuln-assess-tool",
  "private": true,
  "version": "2.0.0",
  "description": "A vulnerability assessment tool for managing SBOMs and checking against public databases",
  "author": "VulnAssessTool",
  "type": "module",
  "main": "dist/server/index.js",
  "homepage": "https://github.com/xarlord/d-fence-vulnerability-assesment-tool",
  "bin": {
    "vulnshield": "dist/cli/index.js"
  },
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"cross-env NODE_ENV=development tsx watch server/index.ts\" \"vite\"",
    "dev:server": "cross-env NODE_ENV=development tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "build:cli": "node scripts/build-cli.mjs",
    "build:all": "npm run build && npm run build:server && npm run build:cli",
    "build:analyze": "cross-env ANALYZE=true npm run build",
    "start": "node dist/server/index.js",
    "cli": "node dist/cli/index.js",
    "cli:dev": "tsx cli/index.ts",
    "lint": "eslint . --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "test:integration": "vitest --config tests/integration/vitest.integration.config.ts",
    "test:perf": "vitest --config tests/perf/vitest.perf.config.ts",
    "test:ui": "vitest --ui",
    "e2e:prepare": "node scripts/e2e-prepare.mjs",
    "test:e2e": "npm run e2e:prepare && playwright test",
    "test:e2e:ui": "npm run e2e:prepare && playwright test --ui",
    "test:e2e:headed": "npm run e2e:prepare && playwright test --headed",
    "test:e2e:debug": "npm run e2e:prepare && playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:e2e:features": "npm run e2e:prepare && playwright test --project=features",
    "test:e2e:workflows": "npm run e2e:prepare && playwright test --project=workflows",
    "test:e2e:visual": "npm run e2e:prepare && playwright test --project=visual",
    "test:e2e:a11y": "npm run e2e:prepare && playwright test --project=a11y",
    "test:bdd": "cross-env TSX_TSCONFIG_PATH=tests/bdd/tsconfig.json NODE_OPTIONS=\"--import tsx\" cucumber-js --tags \"not @ui and not @wip\"",
    "test:bdd:watch": "cross-env TSX_TSCONFIG_PATH=tests/bdd/tsconfig.json NODE_OPTIONS=\"--import tsx\" cucumber-js --tags \"not @ui and not @wip\"",
    "checksums": "node scripts/generate-checksums.js",
    "sync": "node scripts/sync.js",
    "provision:syft": "tsx scripts/provision-syft.ts",
    "seed-db": "node scripts/seed-test-db.js",
    "build:seed-db": "tsx scripts/seed-database.ts",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{ts,tsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,json,md,css}\"",
    "type-check": "tsc --noEmit",
    "errors": "npx tsx scripts/watch-errors.ts",
    "errors:json": "npx tsx scripts/watch-errors.ts --json",
    "errors:resolve": "npx tsx scripts/watch-errors.ts --mark-resolved",
    "errors:clear": "npx tsx scripts/watch-errors.ts --clear",
    "errors:count": "npx tsx scripts/watch-errors.ts --count"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.21",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@types/cytoscape": "^3.21.9",
    "@types/multer": "^2.1.0",
    "@types/react-grid-layout": "^1.3.6",
    "axios": "^1.13.4",
    "better-sqlite3": "^12.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "cytoscape": "^3.33.1",
    "cytoscape-fcose": "^2.2.0",
    "date-fns": "^4.1.0",
    "driver.js": "^1.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.1",
    "fast-xml-parser": "^5.3.4",
    "helmet": "^8.1.0",
    "jspdf": "^4.1.0",
    "jspdf-autotable": "^5.0.7",
    "lucide-react": "^0.563.0",
    "multer": "^2.2.0",
    "node-cron": "^4.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-grid-layout": "^2.2.2",
    "react-hook-form": "^7.71.1",
    "react-router-dom": "^7.13.0",
    "react-virtuoso": "^4.18.1",
    "reactflow": "^11.11.4",
    "recharts": "^3.7.0",
    "sql.js": "^1.12.0",
    "tailwind-merge": "^3.4.1",
    "tailwindcss": "^3.4.19",
    "ws": "^8.20.1",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@cucumber/cucumber": "^12.6.0",
    "@cucumber/pretty-formatter": "^3.0.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.58.1",
    "@stryker-mutator/core": "^9.5.1",
    "@stryker-mutator/vitest-runner": "^9.5.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/node": "^24.10.9",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.9",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.1",
    "@types/xlsx": "^0.0.35",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.18",
    "@vitest/ui": "^4.0.18",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^28.0.0",
    "lint-staged": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.3",
    "rollup-plugin-visualizer": "^7.0.1",
    "supertest": "^7.2.2",
    "tailwindcss-animate": "^1.0.7",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vitest": "^4.0.18"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/xarlord/d-fence-vulnerability-assesment-tool.git"
  }
}
